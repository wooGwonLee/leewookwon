generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MarketItem {
  id          String   @id @default(uuid())
  name        String
  price       Float
  description String?
  viewCount   Int      @default(0)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites Favorite[]
  reviews   Review[]
  images    MarketItemImage[]
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("market_items")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MarketItem[]

  @@map("categories")
}

model MarketItemImage {
  id           String   @id @default(uuid())
  marketItemId String
  url          String
  filename     String
  createdAt    DateTime @default(now())

  marketItem MarketItem @relation(fields: [marketItemId], references: [id], onDelete: Cascade)

  @@map("market_item_images")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites Favorite[]
  reviews   Review[]

  @@map("users")
}

model Favorite {
  id           String   @id @default(uuid())
  userId       String
  marketItemId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketItem MarketItem @relation(fields: [marketItemId], references: [id], onDelete: Cascade)

  @@unique([userId, marketItemId])
  @@map("favorites")
}

model Review {
  id           String   @id @default(uuid())
  userId       String
  marketItemId String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketItem MarketItem @relation(fields: [marketItemId], references: [id], onDelete: Cascade)

  @@unique([userId, marketItemId])
  @@map("reviews")
}
